"""Investigates an openQA job failure using an LLM."""

from __future__ import annotations

import json
import logging
import operator
import os
import subprocess
import sys
from collections import deque
from dataclasses import dataclass
from typing import Annotated, Any
from urllib.parse import urlparse, urlunparse

import httpx
import typer

USER_AGENT = "openqa-llm-investigate (https://github.com/os-autoinst/os-autoinst-scripts)"

MAX_BUILD_FAILURES_HINT = 20
DEBUG_VERBOSITY_LEVEL = 2
INFO_VERBOSITY_LEVEL = 1

log = logging.getLogger(__name__)

app = typer.Typer(add_completion=False)


@dataclass(frozen=True)
class JobSettings:
    """openQA job settings for history matching."""

    build: str
    distri: str
    version: str
    arch: str
    flavor: str


@dataclass(frozen=True)
class InvestigationConfig:
    """Configuration for LLM investigation."""

    force: bool
    dry: bool
    llm_url: str
    llm_model: str
    timeout: int


@dataclass(frozen=True)
class JobIdentity:
    """Identity of an openQA job."""

    client: httpx.Client
    base_url: str
    job_id: str


@dataclass(frozen=True)
class InvestigationContext:
    """Context for LLM investigation."""

    identity: JobIdentity
    job: dict[str, Any]
    settings: JobSettings
    config: InvestigationConfig
    failed_modules: list[str]
    build_failures: int
    same_module_failures: int
    consecutive_failures: int


def fetch_json(client: httpx.Client, url: str, params: dict[str, Any] | None = None, default: Any = None) -> Any:  # noqa: ANN401
    """Fetch JSON from URL."""
    try:
        response = client.get(url, params=params)
        response.raise_for_status()
        return response.json()
    except Exception as e:
        log.warning("Failed to fetch JSON from %s with params %s: %s", url, params, e)
        return default if default is not None else {}


def fetch_text(client: httpx.Client, url: str, max_lines: int = 200) -> str:
    """Fetch text from URL, limiting to max_lines."""
    try:
        lines: deque[str] = deque(maxlen=max_lines)
        with client.stream("GET", url) as response:
            response.raise_for_status()
            for line in response.iter_lines():
                lines.append(line)
        return "\n".join(lines)
    except Exception as e:
        log.warning("Failed to fetch text from %s: %s", url, e)
        return ""


def post_comment(base_url: str, job_id: str, comment: str) -> None:
    """Post a comment to an openQA job."""
    cmd = [
        "openqa-cli",
        "api",
        "--header",
        f"User-Agent: {USER_AGENT}",
        "--host",
        base_url,
        "-X",
        "POST",
        f"jobs/{job_id}/comments",
        f"text={comment}",
    ]
    try:
        res = subprocess.run(cmd, check=True, capture_output=True, text=True)
        log.debug("Posted comment to %s/t%s: %s", base_url, job_id, res.stdout)
    except subprocess.CalledProcessError as e:
        log.error("Failed to post comment: %s", e.stderr)


def setup_logging(verbose: int, quiet: bool) -> None:  # noqa: FBT001
    """Set up logging based on verbosity and quiet flags."""
    if quiet:
        level = logging.ERROR
    elif verbose >= DEBUG_VERBOSITY_LEVEL:
        level = logging.DEBUG
    elif verbose >= INFO_VERBOSITY_LEVEL:
        level = logging.INFO
    else:
        level = logging.WARNING
    logging.basicConfig(level=level, format="%(levelname)s: %(message)s", stream=sys.stderr, force=True)


def parse_job_url(job_url: str) -> tuple[str, str]:
    """Parse openQA job URL or ID into base URL and job ID."""
    parsed_url = urlparse(job_url)
    if parsed_url.scheme:
        base_url = urlunparse((parsed_url.scheme, parsed_url.netloc, "", "", "", ""))
        job_id = parsed_url.path.replace("/tests/", "", 1)
    else:
        base_url = os.environ.get("OPENQA_URL", "https://openqa.opensuse.org")
        job_id = job_url
    return base_url, job_id


def _shares_failed_modules(other_job: dict[str, Any], target_modules: set[str]) -> bool:
    """Check if the given job has failures in any of the target modules."""
    other_failed = (m.get("name") for m in other_job.get("modules", []) if m.get("result") == "failed")
    return bool(target_modules.intersection(other_failed))


def _get_history_stats(
    identity: JobIdentity,
    job: dict[str, Any],
    settings: JobSettings,
    failed_modules: list[str],
) -> tuple[int, int, int]:
    """Fetch history statistics (build failures, similar failures, consecutive failures)."""
    build_failed_jobs = build_history_data.get("jobs", [])
    build_failures = len(build_failed_jobs)

    failed_modules_set = set(failed_modules)

    def is_similar(j: dict[str, Any]) -> bool:
        return str(j.get("id")) != str(identity.job_id) and _shares_failed_modules(j, failed_modules_set)

    same_module_failures = sum(1 for j in build_failed_jobs if is_similar(j)) if failed_modules else 0

    # Search for consecutive failures of the same test
    test_params = {
        "test": job.get("test", "unknown"),
        "distri": settings.distri,
        "version": settings.version,
        "arch": settings.arch,
        "flavor": settings.flavor,
        "limit": 100,
    }
    test_history_data = fetch_json(identity.client, f"{identity.base_url}/api/v1/jobs", params=test_params)
    test_jobs = sorted(test_history_data.get("jobs", []), key=operator.itemgetter("id"), reverse=True)

    target_id_int = int(identity.job_id)
    valid_results = {"passed", "softfailed", "failed"}
    relevant_jobs = [
        j
        for j in test_jobs
        if j["id"] <= target_id_int and j.get("state") == "done" and j.get("result") in valid_results
    ]
    consecutive_failures = next(
        (i for i, j in enumerate(relevant_jobs) if j.get("result") != "failed"), len(relevant_jobs)
    )

    if not any(j["id"] == target_id_int for j in test_jobs):
        log.warning(
            "Job %s not found in recent history (limit %s). Streak count may be inaccurate.",
            identity.job_id,
            test_params["limit"],
        )

    return build_failures, same_module_failures, consecutive_failures


def _build_prompt(
    ctx: InvestigationContext,
    investigation: dict[str, Any],
    log_text: str,
) -> str:
    """Build the LLM prompt."""
    hint = ""
    if ctx.build_failures > MAX_BUILD_FAILURES_HINT:
        hint = f"\n(Note: {ctx.build_failures} failures across this build strongly implies a backend infrastructure outage or a widespread environment issue rather than a specific product bug.)"

    return f"""You are analyzing an openQA test run failure.
Job details:
- Test: {ctx.job.get("test", "unknown")}
- Failed module(s): {", ".join(ctx.failed_modules) if ctx.failed_modules else "unknown"}
- Group: {ctx.job.get("group", "unknown")}
- Build: {ctx.settings.build}
- Distri: {ctx.settings.distri}
- Version: {ctx.settings.version}
- Arch: {ctx.settings.arch}
- Flavor: {ctx.settings.flavor}
- Result: {ctx.job.get("result", "unknown")}
- Total failed jobs in this build (across all tests): {ctx.build_failures}{hint}
- Other jobs in this build failing in the exact same module(s): {ctx.same_module_failures}
- Consecutive recent failures for this specific test (same name, arch, flavor): {ctx.consecutive_failures}

Investigation info (diff to last good):
{json.dumps(investigation.get("diff_to_last_good", "None available"))}

Log tail (last 200 lines):
{log_text}

Provide exactly 3 sentences answering:
1. Is it a new or existing issue? Is it likely a product regression, test regression, or infrastructure problem?
2. Does the same issue appear in other tests in the same build, and did it appear in the history of the same build?
3. Should 'openqa-investigate' be triggered to schedule further bisect tests? Start your 3rd sentence EXACTLY with "BISECT: YES" or "BISECT: NO" followed by the reason.
   - If other jobs in the same build are failing in the exact same module, this is a widespread issue. You MUST answer BISECT: NO to prevent redundant and costly bisections, as another job has likely already triggered it.
   - If the failure is isolated to ONLY this job in the current build, AND the log contains an explicit product error or test assertion failure (e.g., 'actual size fits X: fail', 'command not found', 'segmentation fault'), it strongly points to a new regression. In this isolated case, you MUST answer BISECT: YES.
"""


def _get_job_data(identity: JobIdentity) -> dict[str, Any]:
    """Fetch and validate job data."""
    job_data = fetch_json(identity.client, f"{identity.base_url}/api/v1/jobs/{identity.job_id}/details")
    if not job_data or "job" not in job_data:
        # Fallback for openQA versions/configurations where /details might fail
        job_data = fetch_json(identity.client, f"{identity.base_url}/api/v1/jobs/{identity.job_id}")
    if not job_data or "job" not in job_data:
        log.error("Could not retrieve job data for job %s from %s", identity.job_id, identity.base_url)
        sys.exit(1)
    return job_data["job"]


def _perform_investigation(
    identity: JobIdentity,
    config: InvestigationConfig,
) -> None:
    """Perform LLM investigation for the given job."""
    # Check for existing LLM investigation comments
    comments = fetch_json(identity.client, f"{identity.base_url}/api/v1/jobs/{identity.job_id}/comments", default=[])
    if not config.force and any(c.get("text", "").startswith("**LLM Investigation summary:**") for c in comments):
        log.info("Job %s already has an LLM investigation summary, skipping.", identity.job_id)
        sys.exit(0)

    job = _get_job_data(identity)
    if job.get("result") in {"passed", "softfailed"}:
        log.info("Job %s %s, skipping investigation.", identity.job_id, job.get("result"))
        sys.exit(0)

    failed_modules = [m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"]
    log_text = fetch_text(identity.client, f"{identity.base_url}/tests/{identity.job_id}/file/autoinst-log.txt")
    investigation = fetch_json(identity.client, f"{identity.base_url}/tests/{identity.job_id}/investigation_ajax")

    s = job.get("settings", {})
    settings = JobSettings(
        build=s.get("BUILD", "unknown"),
        distri=s.get("DISTRI", "unknown"),
        version=s.get("VERSION", "unknown"),
        arch=s.get("ARCH", "unknown"),
        flavor=s.get("FLAVOR", "unknown"),
    )
    stats = _get_history_stats(identity, job, settings, failed_modules)
    ctx = InvestigationContext(
        identity=identity,
        job=job,
        settings=settings,
        config=config,
        failed_modules=failed_modules,
        build_failures=stats[0],
        same_module_failures=stats[1],
        consecutive_failures=stats[2],
    )

    prompt = _build_prompt(ctx, investigation, log_text)

    req = {"model": config.llm_model, "messages": [{"role": "user", "content": prompt}], "temperature": 0.3}

    try:
        res = identity.client.post(config.llm_url, json=req, timeout=config.timeout)
        res.raise_for_status()
        llm_response = res.json()["choices"][0]["message"]["content"]
    except httpx.ConnectError:
        log.error(
            "Could not connect to LLM server at %s. Please check if the server is running or the LLM_API_URL environment variable is correct.",
            config.llm_url,
        )
        sys.exit(1)
    except httpx.HTTPStatusError as e:
        log.error("LLM API %s (%s) status %d: %s", llm_url, llm_model, e.response.status_code, e.response.text)
        sys.exit(1)
    except Exception as e:
        log.error("LLM API %s (%s) failed: %s", llm_url, llm_model, e)
        sys.exit(1)

    # Print the job URL to stdout ONLY if BISECT: YES is recommended.
    # This makes the script act as a gatekeeper, similar to `openqa-label-known-issues`.
    if "BISECT: YES" in llm_response.upper():
        print(f"{identity.base_url}/tests/{identity.job_id}")

    if config.dry:
        print(f"**LLM Investigation summary:**\n\n{llm_response}")
    else:
        post_comment(identity.base_url, identity.job_id, f"**LLM Investigation summary:**\n\n{llm_response}")


@app.command()
def investigate(
    job_url: str = typer.Argument(..., help="The openQA test URL or job ID for which to trigger LLM investigation"),
    verbose: Annotated[int, typer.Option("--verbose", "-v", count=True, help="Increase verbosity")] = 0,
    quiet: Annotated[bool, typer.Option("--quiet", "-q", help="Quiet mode")] = False,  # noqa: FBT002
    dry: Annotated[  # noqa: FBT002
        bool, typer.Option("--dry", help="Dry run mode: output summary instead of posting a comment")
    ] = False,
    force: Annotated[  # noqa: FBT002
        bool,
        typer.Option(
            "--force",
            "-f",
            help="Force another analysis even if an LLM comment already exists or if the job passed/softfailed",
        ),
    ] = False,
    timeout: Annotated[int, typer.Option("--timeout", help="Timeout for LLM API requests in seconds")] = int(
        os.environ.get("LLM_TIMEOUT", "600")
    ),
) -> None:
    """Investigate an openQA job failure using an LLM."""
    setup_logging(verbose, quiet)
    base_url, job_id = parse_job_url(job_url)

    if not job_id.isdigit():
        log.error("Invalid job ID: %s", job_id)
        sys.exit(1)

    llm_url = os.environ.get("LLM_API_URL", "http://localhost:8080/v1/chat/completions")
    llm_model = os.environ.get("LLM_MODEL", "gemma-4-26B-A4B-it")

    config = InvestigationConfig(force=force, dry=dry, llm_url=llm_url, llm_model=llm_model, timeout=timeout)

    with httpx.Client(headers={"User-Agent": USER_AGENT}) as client:
        identity = JobIdentity(client=client, base_url=base_url, job_id=job_id)
        _perform_investigation(identity, config)


if __name__ == "__main__":
    app()
