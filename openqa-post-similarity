from __future__ import annotations

"""Investigate openQA job failures using Levenshtein distance on log errors.

This script scans all autoinst-log.txt files in the testresults directory searching
for error messages. Then it computes the Levenshtein distance and posts the
results as openQA comments.
"""

from __future__ import annotations

import argparse
import json
import logging
import operator
import pathlib
import sys
from curses.ascii import isdigit

import Levenshtein
from openqa_client.client import OpenQA_Client
from pyecharts import options as opts
from pyecharts.charts import Graph
from tqdm import tqdm


def init_logging() -> logging.Logger:
    """Initialize logging to stdout."""
    logger = logging.getLogger()
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        logger.addHandler(logging.StreamHandler(sys.stdout))
    return logger


class SimilarityAnalyzer:
    """Analyzer for openQA job failure similarity."""

    def __init__(self, logger: logging.Logger, testdir: str) -> None:
        """Initialize the analyzer."""
        self.logger = logger
        self.testdir = testdir
        self.id_msg: dict[str, str] = {}
        self.result: dict[str, list[str]] = {}

    def read_errors(self, path: str | pathlib.Path) -> None:
        """Read error messages from autoinst-log.txt."""
        with pathlib.Path(path).open(encoding="utf-8") as f:
            text = f.read()
            anchor = 0
            begin = text.find("Test died", anchor)
            while begin != -1:
                anchor = begin + 1
                end = text.find("\n", begin)
                self.id_msg[pathlib.Path(path).parent.name] = text[begin:end]
                begin = text.find("Test died", anchor)

    def load_job_messages(self) -> None:
        """Read error messages from all jobs in testdir."""
        json_path = pathlib.Path("id_msg.json")
        test_path = pathlib.Path(self.testdir)
        if not json_path.exists():
            self.logger.info("id_msg.json does not exist.")
            logs = [p / "autoinst-log.txt" for p in test_path.iterdir() if p.is_dir()]
            for path in tqdm(logs, desc="Processing testresults directory", unit="test"):
                if path.exists():
                    self.read_errors(path)
        else:
            self.logger.info("id_msg.json exists.")
            with json_path.open(encoding="utf-8") as f:
                self.id_msg = json.load(f)
            checked_dirs = set(self.id_msg.keys())
            unchecked_dirs = [p for p in test_path.iterdir() if p.is_dir() and p.name not in checked_dirs]
            for job_dir in tqdm(unchecked_dirs, desc="Processing testresults directory", unit="test"):
                path = job_dir / "autoinst-log.txt"
                if path.exists():
                    self.read_errors(path)

        with json_path.open("w", encoding="utf-8") as f:
            json.dump(self.id_msg, f, sort_keys=False, indent=4, separators=(",", ":"))

    def calculate_distances(self, *, output: bool, number: int) -> None:
        """Calculate Levenshtein distance between error messages."""
        f = None
        if output:
            f = pathlib.Path("distance_result.txt").open("w", encoding="utf-8")

        items = list(self.id_msg.items())
        for index, (key1, value1) in enumerate(tqdm(items, desc="Calculating message distance", unit="error")):
            calculate = {}
            for key2, value2 in items:
                if key1 == key2:
                    continue
                calculate[key2] = Levenshtein.distance(value1, value2)

            calculate_sorted = sorted(calculate.items(), key=operator.itemgetter(1))
            top_matches = calculate_sorted[:number]
            matched_ids = [m[0] for m in top_matches]
            self.result[key1] = matched_ids

            if f:
                f.write(f"Index: {index}\nOriginal error message:\nJob ID: {key1}\n{value1}\n")
                f.write(f"matched error message (top {number}):\n")
                f.writelines(f"Job ID: {mid}\n{self.id_msg[mid]}\n" for mid in matched_ids)
                f.write("\n")

        if f:
            self.logger.info("Distance file output.")
            f.close()

    def post_to_openqa(self, server: str, number: int) -> None:
        """Post similarity results as comments to openQA."""
        client = OpenQA_Client(server)
        for origin, matched in tqdm(self.result.items(), desc="Posting comments", unit="comment"):
            text = f"Top {number} similar failures:\r\n"
            for job_id in matched:
                text += f"[{job_id}](https://openqa.opensuse.org/tests/{job_id})\r\n"
            client.openqa_request("POST", f"jobs/{origin}/comments", {"text": text})

    @staticmethod
    def _get_graph_data(cut: dict[str, int]) -> tuple[list[opts.GraphNode], list[opts.GraphLink]]:
        """Generate nodes and links for the graph with optimized distance calculation."""
        nodes_data = [opts.GraphNode(name=msg, symbol_size=freq) for msg, freq in cut.items()]
        links_data = []

        messages = list(cut.keys())
        n = len(messages)
        min_items_for_graph = 2
        if n < min_items_for_graph:
            return nodes_data, links_data

        distances = {}
        for i in range(n):
            for j in range(i + 1, n):
                dist = Levenshtein.distance(messages[i], messages[j])
                distances[messages[i], messages[j]] = dist

        all_dists = list(distances.values())
        max_dist = max(all_dists)
        min_dist = min(all_dists)
        threshold = (max_dist + min_dist) / 2

        for (m1, m2), dist in distances.items():
            if dist < threshold:
                links_data.append(opts.GraphLink(source=m1, target=m2, value=dist))

        return nodes_data, links_data

    def draw_chart(self, points: int, geometry: str, save_path: str) -> None:
        """Draw a graph of error message similarities."""
        resolution = geometry.split("x")
        expected_parts = 2
        if len(resolution) != expected_parts or not all(isdigit(i) for i in resolution):
            self.logger.warning("Wrong geometry format")
            return

        msg_counts = {}
        for msg in self.id_msg.values():
            msg_counts[msg] = msg_counts.get(msg, 0) + 1

        # Slice top 'points' messages
        sorted_msgs = sorted(msg_counts.items(), key=operator.itemgetter(1), reverse=True)
        cut = dict(sorted_msgs[:points])

        nodes_data, links_data = self._get_graph_data(cut)
        (
            Graph(init_opts=opts.InitOpts(height=f"{resolution[0]}px", width=f"{resolution[1]}px"))
            .add(
                "",
                nodes_data,
                links_data,
                repulsion=400,
                edge_length=[10, 1000],
                layout="force",
                gravity=0.01,
                edge_label=opts.LabelOpts(is_show=False, position="middle", formatter="{b} : {c}"),
                label_opts=opts.LabelOpts(is_show=False),
            )
            .set_global_opts(title_opts=opts.TitleOpts(title="Levenshtein distance"))
            .render(save_path)
        )


if __name__ == "__main__":
    help_message = (
        "This script scans all autoinst-log.txt files in the testresults directory searching for error "
        "messages. Then it computes the Levenshtein distance and posts the results as openQA comments."
    )
    parser = argparse.ArgumentParser(description=help_message)
    parser.add_argument("-o", "--output", action="store_true", help="Whether outputs the results into a txt file")
    parser.add_argument("-s", "--server", default="http://127.0.0.1:9526", type=str, help="OpenQA server URL")
    parser.add_argument("-n", "--number", default=10, type=int, help="Number of similar errors")
    parser.add_argument(
        "-d", "--dir", default="/var/lib/openqa/testresults/", type=str, help="Directory of OpenQA test results"
    )
    parser.add_argument("-p", "--post", action="store_true", help="Whether post similarity to openQA website")
    parser.add_argument(
        "-c",
        "--chart",
        default=0,
        type=int,
        help="Number of points in chart (If the number is 0, the chart won't be drawn)",
    )
    parser.add_argument("--geometry", default="1920x1080", type=str, help="Chart resolution (e.g. 1920x1080)")
    parser.add_argument(
        "--save", default="./similarity.html", type=str, help="Path and name to save the chart (e.g. ./similarity.html)"
    )
    args = parser.parse_args()

    log_obj = init_logging()
    analyzer = SimilarityAnalyzer(log_obj, args.dir)
    analyzer.load_job_messages()
    analyzer.calculate_distances(output=args.output, number=args.number)

    if args.post:
        analyzer.post_to_openqa(server=args.server, number=args.number)
    if args.chart != 0:
        analyzer.draw_chart(points=args.chart, geometry=args.geometry, save_path=args.save)
